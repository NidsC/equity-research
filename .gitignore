__pycache__/
*.py[cod]
.DS_Store
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# Orchestration state — worker worktrees, run logs, pidfiles and morning
# reports are all local scratch.
.worktrees/
orchestrator/runs/

# Queued task files are ephemeral work orders, not source. Untracked so that
# queueing work does not dirty the tree — which overnight.sh's preflight
# refuses to run against.
orchestrator/tasks/queue/*
!orchestrator/tasks/queue/README.md

# Filing cache and derived stores can be regenerated from EDGAR
data/cache/
data/*.duckdb
data/*.duckdb.wal
reports/
